# === Base de datos ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/borondo
DATABASE_POOL_SIZE=10

# === Auth ===
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === AWS (local dev) ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# === S3 ===
S3_BUCKET_MEDIA=borondotours-media-dev
S3_BUCKET_DOCS=borondotours-docs-dev

# === SES ===
SES_FROM_EMAIL=noreply@borondotours.com

# === Onepayla ===
ONEPAYLA_API_KEY=
ONEPAYLA_WEBHOOK_SECRET=

# === Mapbox (frontend) ===
BUN_PUBLIC_MAPBOX_TOKEN=

# === Frontend URLs ===
BUN_PUBLIC_API_URL=http://localhost:3001/api/v1
BUN_PUBLIC_WS_URL=ws://localhost:3007

# === Service Ports (local dev) ===
PORT_CORE=3001
PORT_TOURS=3002
PORT_BOOKINGS=3003
PORT_PAYMENTS=3004
PORT_OPERATORS=3005
PORT_NOTIFICATIONS=3006
PORT_CHAT=3007
PORT_JOBS=3008
PORT_ADS=3009
