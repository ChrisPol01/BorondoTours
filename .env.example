# ============================================================
# BorondoTours — Variables de Entorno
# Copia este archivo como .env y completa los valores reales
# NUNCA comitas el .env real al repositorio
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# ------------------------------------------------------------
# Base de Datos — PostgreSQL (Neon en Fase 1)
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/borondotours?sslmode=require

# ------------------------------------------------------------
# Redis (BullMQ + Rate Limiting + OTP)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Auth — JWT (RS256)
# Generar: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# ------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=30d

# ------------------------------------------------------------
# Google OAuth2
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ------------------------------------------------------------
# AWS — Credenciales (IAM User con permisos minimos)
# ------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ------------------------------------------------------------
# AWS S3 — Object Storage
# ------------------------------------------------------------
AWS_S3_BUCKET_PRIVATE=borondo-private-docs-dev
AWS_S3_BUCKET_PUBLIC=borondo-public-media-dev
AWS_S3_PRESIGNED_URL_EXPIRY=900
AWS_S3_GLACIER_TRANSITION_DAYS=15

# ------------------------------------------------------------
# AWS SES — Email Transaccional
# ------------------------------------------------------------
AWS_SES_FROM_EMAIL=noreply@borondotours.com
AWS_SES_REPLY_TO=soporte@borondotours.com

# ------------------------------------------------------------
# AWS SNS — SMS OTP (Fase 2)
# ------------------------------------------------------------
AWS_SNS_SENDER_ID=BorondoTours

# ------------------------------------------------------------
# AWS CloudWatch Logs (Fase 3 — ECS)
# ------------------------------------------------------------
AWS_CLOUDWATCH_LOG_GROUP=/borondo/backend/production
AWS_CLOUDWATCH_LOG_STREAM=api-server

# ------------------------------------------------------------
# OnePay.la — Pasarela de Pagos
# ------------------------------------------------------------
ONEPAY_API_KEY=sk_live_xxxxxxxxxxxx
ONEPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
ONEPAY_BASE_URL=https://api.onepay.la/v1

# ------------------------------------------------------------
# Siigo — Facturacion Electronica DIAN (Fase 2)
# ------------------------------------------------------------
SIIGO_USERNAME=api_user@borondotours.com
SIIGO_ACCESS_KEY=xxxxxxxxxxxx
SIIGO_BASE_URL=https://api.siigo.com

# ------------------------------------------------------------
# Meilisearch — Motor de Busqueda (Fase 2)
# ------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey_xxxxxxxxxxxx

# ------------------------------------------------------------
# Google reCAPTCHA v3 (Fase 2)
# ------------------------------------------------------------
RECAPTCHA_SECRET_KEY=6Lc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_MIN_SCORE=0.5

# ------------------------------------------------------------
# Expo Push Notifications — App Movil (Fase 3)
# ------------------------------------------------------------
EXPO_ACCESS_TOKEN=xxxxxxxxxxxx

# ------------------------------------------------------------
# DynamoDB — Chat (Fase 2)
# ------------------------------------------------------------
DYNAMODB_CHAT_TABLE=borondo-chat-messages
DYNAMODB_CHAT_TTL_DAYS=1

# ------------------------------------------------------------
# BullMQ
# ------------------------------------------------------------
BULLMQ_PREFIX=borondo

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ------------------------------------------------------------
# Feature Flags (activar segun la fase)
# ------------------------------------------------------------
FEATURE_MEILISEARCH=false
FEATURE_SMS_OTP=false
FEATURE_SIIGO=false
FEATURE_MFA=false
FEATURE_DYNAMODB_CHAT=false
