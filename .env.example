# ============================================================
# BorondoTours — Variables de entorno
# Copiar a .env y completar con valores reales
# NUNCA commitear el archivo .env
# ============================================================

# ─── Base de datos ──────────────────────────────────────────
DATABASE_URL=postgresql://usuario:password@localhost:5432/borondotours
DATABASE_URL_TEST=postgresql://usuario:password@localhost:5432/borondotours_test

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth / JWT ─────────────────────────────────────────────
JWT_PRIVATE_KEY=           # RS256 private key (base64)
JWT_PUBLIC_KEY=            # RS256 public key (base64)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth2 ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── AWS ────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_PUBLIC=borondotours-media
AWS_S3_BUCKET_PRIVATE=borondotours-private
AWS_SES_FROM_EMAIL=noreply@borondotours.com

# ─── Bold (Pagos Colombia) ──────────────────────────────────
BOLD_API_KEY=
BOLD_SECRET_KEY=
BOLD_WEBHOOK_SECRET=

# ─── Mapbox ─────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# ─── DynamoDB (Fase 2) ──────────────────────────────────────
DYNAMODB_CHAT_TABLE=borondotours-chat
DYNAMODB_ENDPOINT=              # Solo para local (DynamoDB Local)

# ─── Meilisearch (Fase 2) ───────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# ─── Siigo (Facturación - Fase 2) ───────────────────────────
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
