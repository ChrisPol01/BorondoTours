BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Borondo Tours SAS//Calendario Tributario//ES
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Borondo Tours - Obligaciones Tributarias
X-WR-TIMEZONE:America/Bogota
X-WR-CALDESC:Vencimientos tributarios de Borondo Tours SAS (NIT 902.080.308-5, ultimo digito 8). Fechas aproximadas; confirmar el dia exacto en el portal DIAN/Cali antes de cada vencimiento.

BEGIN:VEVENT
UID:bt-ret-mensual-template@borondotours.com
DTSTAMP:20261012T120000Z
SUMMARY:Declarar y pagar Retencion en la Fuente (form. 350)
DESCRIPTION:Preparamos nosotros -> contador firma. Periodo: mes anterior. Fecha aprox dia 22-24 (digito NIT = 8). Confirmar dia exacto en calendario DIAN.
DTSTART;VALUE=DATE:20261022
DTEND;VALUE=DATE:20261023
RRULE:FREQ=MONTHLY;BYMONTHDAY=22
BEGIN:VALARM
TRIGGER:-P7D
ACTION:DISPLAY
DESCRIPTION:En 7 dias vence la Retencion en la Fuente - empezar a preparar
END:VALARM
BEGIN:VALARM
TRIGGER:-P1D
ACTION:DISPLAY
DESCRIPTION:Manana vence la Retencion en la Fuente
END:VALARM
END:VEVENT

