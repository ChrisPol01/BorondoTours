{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mapa de evidencias de auditoría (AuditEvidenceMap.json, §9.1)",
  "type": "object",
  "required": [
    "feature",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "controlId",
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "controlId": {
            "type": "string",
            "maxLength": 40
          },
          "ref": {
            "type": "string",
            "maxLength": 120
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
