{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Informe de área (AreaReport.<área>.json): reparto, coherencia, desbloqueos y resultado del supervisor",
  "type": "object",
  "required": [
    "feature",
    "area",
    "lead",
    "delegation",
    "assignments",
    "coherence",
    "blockers",
    "decisions",
    "escalations",
    "result",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "lead": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "delegation": {
      "type": "object",
      "required": [
        "from",
        "requestId",
        "scope"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "role",
          "task",
          "requestId",
          "dependsOn",
          "status",
          "artifacts"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "requestId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60
          },
          "dependsOn": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,40}$"
            }
          },
          "status": {
            "enum": [
              "open",
              "answered",
              "blocked",
              "declined",
              "skipped"
            ]
          },
          "artifacts": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,40}(:[a-z0-9][a-z0-9-]{0,40})?(@v[0-9]+)?$"
            }
          }
        }
      }
    },
    "coherence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "check",
          "result",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "na"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "raisedBy",
          "resolution",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,40}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "raisedBy": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "resolution": {
            "enum": [
              "supported",
              "decided",
              "escalated",
              "open"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "delegable",
          "decision",
          "rationale",
          "approver"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,40}$"
          },
          "class": {
            "enum": [
              "prioritization",
              "postmortem",
              "change",
              "risk",
              "pir",
              "production",
              "publish",
              "delete",
              "spend",
              "credentials",
              "legal",
              "conflict",
              "none"
            ]
          },
          "delegable": {
            "type": "boolean"
          },
          "decision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "approver": {
            "type": "string",
            "pattern": "^(agent:[a-z][a-z0-9-]{1,40}|user|none)$"
          }
        }
      }
    },
    "escalations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "to",
          "requestId",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "requestId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "status",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "partial",
            "blocked"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "id",
        "title",
        "entryType",
        "owner",
        "due"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,40}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "pattern": "^[\\p{L}\\p{N} .,:()/_-]+$"
        },
        "entryType": {
          "enum": [
            "feature",
            "change",
            "defect",
            "standard",
            "debt",
            "migration-wave",
            "audit-remediation",
            "decommission",
            "experiment",
            "problem"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^(h:)?[a-z][a-z0-9-]{1,40}$"
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "changeClassHint": {
          "enum": [
            "standard",
            "normal",
            "emergency"
          ]
        }
      }
    }
  }
}
