{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alcance de la revisión de operación (ReviewScope.json, §9.1)",
  "type": "object",
  "required": [
    "feature",
    "period",
    "services",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string"
    },
    "period": {
      "type": "string",
      "maxLength": 40
    },
    "services": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 20
      }
    }
  }
}
