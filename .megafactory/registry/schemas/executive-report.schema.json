{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Informe gerencial (ExecutiveReport.json): resultado, avance, riesgos, costo y decisiones con recomendación para el gerente",
  "type": "object",
  "required": [
    "feature",
    "audience",
    "objective",
    "result",
    "progress",
    "risks",
    "cost",
    "decisions",
    "priorities",
    "sources",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string"
    },
    "audience": {
      "enum": [
        "gerente"
      ]
    },
    "objective": {
      "type": "object",
      "required": [
        "business",
        "outcomes"
      ],
      "additionalProperties": false,
      "properties": {
        "business": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "metric",
              "target",
              "by"
            ],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "target": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "by": {
                "type": "string",
                "maxLength": 40
              }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "status",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "on-track",
            "at-risk",
            "off-track",
            "done"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "progress": {
      "type": "object",
      "required": [
        "percent",
        "milestones"
      ],
      "additionalProperties": false,
      "properties": {
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "milestones": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "name",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "status": {
                "enum": [
                  "done",
                  "in-progress",
                  "pending",
                  "blocked"
                ]
              }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "likelihood",
          "impact",
          "mitigation",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,40}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "likelihood": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "impact": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "mitigation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "currency",
        "estimate",
        "actual",
        "budget",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "estimate": {
          "type": "number",
          "minimum": 0
        },
        "actual": {
          "type": "number",
          "minimum": 0
        },
        "budget": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "reserved",
          "question",
          "options",
          "recommendation",
          "preApproved",
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,40}$"
          },
          "class": {
            "enum": [
              "prioritization",
              "postmortem",
              "change",
              "risk",
              "pir",
              "production",
              "publish",
              "delete",
              "spend",
              "credentials",
              "legal",
              "conflict",
              "none"
            ]
          },
          "reserved": {
            "type": "boolean"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "pros",
                "cons"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,40}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "pros": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "cons": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            }
          },
          "recommendation": {
            "type": "object",
            "required": [
              "option",
              "rationale"
            ],
            "additionalProperties": false,
            "properties": {
              "option": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,40}$"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            }
          },
          "preApproved": {
            "type": "boolean"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "priorities": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "method",
          "score",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,40}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "method": {
            "enum": [
              "wsjf",
              "rice",
              "none"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,40}(:[a-z0-9][a-z0-9-]{0,40})?(@v[0-9]+)?$"
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "id",
        "title",
        "entryType",
        "owner",
        "due"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,40}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "pattern": "^[\\p{L}\\p{N} .,:()/_-]+$"
        },
        "entryType": {
          "enum": [
            "feature",
            "change",
            "defect",
            "standard",
            "debt",
            "migration-wave",
            "audit-remediation",
            "decommission",
            "experiment",
            "problem"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^(h:)?[a-z][a-z0-9-]{1,40}$"
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "changeClassHint": {
          "enum": [
            "standard",
            "normal",
            "emergency"
          ]
        }
      }
    }
  }
}
