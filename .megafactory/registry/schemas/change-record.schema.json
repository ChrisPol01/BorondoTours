{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registro de cambio (ChangeRecord.json, §9.1, MF-D29)",
  "type": "object",
  "required": ["feature", "class", "summary", "risk", "implementationWindow", "rollback", "affectedComponents"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string" },
    "class": { "enum": ["standard", "normal", "emergency"] },
    "standardChangeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,60}$" },
    "classRationale": { "type": "string", "maxLength": 1000 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "risk": {
      "type": "object",
      "required": ["level", "description"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["low", "medium", "high"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "implementationWindow": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "maxLength": 40 },
        "end": { "type": "string", "maxLength": 40 }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["plan", "trigger"],
      "additionalProperties": false,
      "properties": {
        "plan": { "type": "string", "maxLength": 2000 },
        "trigger": { "type": "string", "maxLength": 1000 }
      }
    },
    "affectedComponents": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "pendingDecisions": { "type": "array", "items": { "type": "object" } }
  }
}
