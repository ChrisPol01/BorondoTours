{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Informe AgentOps (AgentOpsReport.json, §9.4)",
  "type": "object",
  "required": [
    "feature",
    "period",
    "services",
    "formulaVersion",
    "dora",
    "space",
    "agents",
    "learning",
    "dataQuality"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string"
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$|^\\d{4}-\\d{2}-\\d{2}/\\d{4}-\\d{2}-\\d{2}$"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "formulaVersion": {
      "const": 1
    },
    "dora": {
      "type": "object"
    },
    "space": {
      "type": "object"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "learning": {
      "type": "object"
    },
    "dataQuality": {
      "type": "object",
      "required": [
        "itemsScanned",
        "itemsSkipped",
        "missingFields"
      ],
      "additionalProperties": false,
      "properties": {
        "itemsScanned": {
          "type": "integer",
          "minimum": 0
        },
        "itemsSkipped": {
          "type": "integer",
          "minimum": 0
        },
        "missingFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
