{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triage de reportes (TicketTriage.json, rol service-desk-l1)",
  "type": "object",
  "required": [
    "feature",
    "decisionClass",
    "reserved",
    "summary",
    "options",
    "recommendation",
    "risks",
    "tickets",
    "knownErrorMatches",
    "workaroundsApplied",
    "routing",
    "clusterSignal",
    "approvalPath",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string"
    },
    "decisionClass": {
      "enum": [
        "prioritization",
        "postmortem",
        "change",
        "risk",
        "pir",
        "production",
        "publish",
        "delete",
        "spend",
        "credentials",
        "legal",
        "none"
      ]
    },
    "reserved": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "pros",
          "cons"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,20}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "maxItems": 10
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "maxItems": 10
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "option",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "option": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,20}$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "likelihood",
          "impact",
          "mitigation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,20}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "likelihood": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "impact": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "mitigation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "tickets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "category",
          "impact",
          "urgency",
          "priority",
          "service"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "impact": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "urgency": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "priority": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          },
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    },
    "knownErrorMatches": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "workaroundsApplied": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "routing": {
      "enum": [
        "resolved-l1",
        "to-l2",
        "possible-incident",
        "request-fulfilment"
      ]
    },
    "clusterSignal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "approvalPath": {
      "type": "object",
      "required": [
        "approver",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "approver": {
          "type": "string",
          "pattern": "^(agent:[a-z][a-z0-9-]{1,40}|user)$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "id",
        "title",
        "entryType",
        "owner",
        "due"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,40}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "pattern": "^[\\p{L}\\p{N} .,:()/_-]+$"
        },
        "entryType": {
          "enum": [
            "feature",
            "change",
            "defect",
            "standard",
            "debt",
            "migration-wave",
            "audit-remediation",
            "decommission",
            "experiment",
            "problem"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^(h:)?[a-z][a-z0-9-]{1,40}$"
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "changeClassHint": {
          "enum": [
            "standard",
            "normal",
            "emergency"
          ]
        }
      }
    }
  }
}
