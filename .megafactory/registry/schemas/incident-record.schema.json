{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registro de incidente (IncidentRecord.json, §9.1)",
  "type": "object",
  "required": [
    "feature",
    "service",
    "severity",
    "status",
    "detectedAt",
    "summary",
    "timeline"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string"
    },
    "service": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"
    },
    "severity": {
      "type": "string",
      "maxLength": 20
    },
    "status": {
      "enum": [
        "detected",
        "responding",
        "mitigated",
        "resolved"
      ]
    },
    "detectedAt": {
      "type": "string",
      "maxLength": 40
    },
    "mitigatedAt": {
      "type": "string",
      "maxLength": 40
    },
    "resolvedAt": {
      "type": "string",
      "maxLength": 40
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "impact": {
      "type": "string",
      "maxLength": 2000
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "at",
          "event",
          "by"
        ],
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string",
            "maxLength": 40
          },
          "event": {
            "type": "string",
            "maxLength": 500
          },
          "by": {
            "type": "string",
            "pattern": "^(h:)?[a-z][a-z0-9-]{1,40}$"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "command",
          "purpose",
          "executedBy"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "maxLength": 500
          },
          "purpose": {
            "type": "string",
            "maxLength": 300
          },
          "executedBy": {
            "type": "string",
            "maxLength": 40
          },
          "outputRef": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "causedByRelease": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "slo": {
      "type": "object"
    }
  }
}
