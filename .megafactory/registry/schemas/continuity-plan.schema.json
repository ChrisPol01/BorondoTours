{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan de continuidad (ContinuityPlan.json, §9.1)",
  "type": "object",
  "required": [
    "feature",
    "bia",
    "services"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string"
    },
    "bia": {
      "type": "string",
      "maxLength": 2000
    },
    "services": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "name",
          "rtoMinutes",
          "rpoMinutes",
          "strategy"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "rtoMinutes": {
            "type": "number"
          },
          "rpoMinutes": {
            "type": "number"
          },
          "strategy": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "methods": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/methodBlock"
      },
      "description": "Bloques de método del anfitrión (§22.8): pre-mortem, fmea o fault-tree que exige el disparador high-risk-plan al publicar."
    }
  },
  "$defs": {
    "methodBlock": {
      "type": "object",
      "required": [
        "method",
        "trigger",
        "actors",
        "data",
        "lessons",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$"
        },
        "trigger": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^evt_[0-9a-f-]{36}$"
        },
        "actors": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(h:)?[a-z][a-z0-9-]{1,40}$"
          }
        },
        "data": {
          "type": "object"
        },
        "lessons": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "scope",
              "title",
              "body"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "lesson",
                  "decision",
                  "recurring-error",
                  "anti-pattern",
                  "pattern",
                  "proposal"
                ]
              },
              "scope": {
                "enum": [
                  "role",
                  "area",
                  "project"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 8,
                "maxLength": 120,
                "pattern": "^[\\p{L}\\p{N} .,:()/_-]+$"
              },
              "body": {
                "type": "string",
                "minLength": 20,
                "maxLength": 1200
              },
              "tags": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{1,30}$"
                }
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/methodAction"
          }
        }
      }
    },
    "methodAction": {
      "type": "object",
      "required": [
        "id",
        "title",
        "entryType",
        "owner",
        "due"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,40}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "pattern": "^[\\p{L}\\p{N} .,:()/_-]+$"
        },
        "entryType": {
          "enum": [
            "feature",
            "change",
            "defect",
            "standard",
            "debt",
            "migration-wave",
            "audit-remediation",
            "decommission",
            "experiment",
            "problem"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^(h:)?[a-z][a-z0-9-]{1,40}$"
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "changeClassHint": {
          "enum": [
            "standard",
            "normal",
            "emergency"
          ]
        }
      }
    }
  }
}
