{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "feature",
    "title",
    "problem",
    "goals",
    "stories",
    "scope"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "maxLength": 2000
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^docs/01-Specs/Spec-[A-L]-[^#]+\\.md(#RF-[A-L]\\d{2}[a-z]?)?$"
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "layers",
        "scopePaths"
      ],
      "additionalProperties": false,
      "properties": {
        "apps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ui",
              "api",
              "data",
              "domain-finance",
              "integrations",
              "infra",
              "content-seo",
              "auth-rbac",
              "mobile",
              "events",
              "data-pipeline",
              "analytics",
              "ml",
              "llm",
              "iot"
            ]
          }
        },
        "scopePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "asA",
          "iWant",
          "soThat",
          "invest",
          "acceptanceCriteria",
          "priority",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^US-\\d{3}$"
          },
          "asA": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "SUPER_ADMIN",
              "GERENTE",
              "AGENT",
              "COORD",
              "CLIENT",
              "OPERATOR_ADMIN",
              "OPERATOR_COORD",
              "OPERATOR_AGENT",
              "OPERATOR_GUIDE",
              "OPERATOR_DRIVER",
              "ANONYMOUS"
            ]
          },
          "iWant": {
            "type": "string"
          },
          "soThat": {
            "type": "string"
          },
          "invest": {
            "type": "object",
            "required": [
              "independent",
              "negotiable",
              "valuable",
              "estimable",
              "small",
              "testable"
            ],
            "additionalProperties": false,
            "properties": {
              "independent": {
                "type": "boolean"
              },
              "negotiable": {
                "type": "boolean"
              },
              "valuable": {
                "type": "boolean"
              },
              "estimable": {
                "type": "boolean"
              },
              "small": {
                "type": "boolean"
              },
              "testable": {
                "type": "boolean"
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "given",
                "when",
                "then"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-\\d{3}-\\d+$"
                },
                "given": {
                  "type": "string"
                },
                "when": {
                  "type": "string"
                },
                "then": {
                  "type": "string"
                }
              }
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "size": {
            "type": "string",
            "enum": [
              "S",
              "M",
              "L",
              "XL"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dataElements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nfr": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "statement",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NFR-\\d{2}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "performance",
              "availability",
              "security",
              "a11y",
              "i18n",
              "privacy",
              "cost",
              "observability"
            ]
          },
          "statement": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "baselineIds": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 40,
            "description": "MF-18: ids de profile.json#mandatoryBaseline que cubre este NFR (regla baseline-coverage).",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{1,9}-[0-9]{2,3}$"
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "blocking"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q-\\d{2}$"
          },
          "question": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "answer": {
            "type": "string"
          },
          "answeredBy": {
            "type": "string"
          }
        }
      }
    },
    "pendingDecisions": {
      "$ref": "#/$defs/pendingDecisions"
    },
    "kind": {
      "type": "string",
      "enum": [
        "feature",
        "change",
        "defect",
        "standard",
        "debt",
        "migration-wave",
        "audit-remediation",
        "decommission",
        "experiment"
      ],
      "description": "Tipo de entrada del ítem (§8.2); ausente = feature (PRD v0)."
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9-]+)?$",
            "maxLength": 40
          }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "standard",
            "normal",
            "emergency"
          ]
        },
        "risk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "rollback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "affectedComponents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reproduction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "actual": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "$defs": {
    "pendingDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "blocking",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
