{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alcance de un ciclo de automejora (ImprovementScope.json)",
  "type": "object",
  "required": [
    "feature",
    "goal",
    "targets",
    "successMetric"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "prompts",
          "recipes",
          "mcp",
          "tools",
          "tokens"
        ]
      }
    },
    "successMetric": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    }
  }
}
