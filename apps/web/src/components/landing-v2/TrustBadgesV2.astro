---
/**
 * `TrustBadgesV2` — Sección de propuesta de valor de la Home v2 (`/home-v2`).
 *
 * Basado en `01-home.design.md` §Propuesta de Valor:
 *   • Grid 4 columnas, fondo `arena` (`bg-surface-warm`), padding vertical.
 *   • Iconos Leaf / Camera / Shield / Users (trazo 2px, turquesa).
 *   • Títulos Body1 Bold + subtítulos Body2 azul-condor.
 *   • Astro estático (sin isla) — igual que indica el spec.
 *
 * Usa las claves i18n `trust.*` ya definidas en el namespace `home`.
 */
import { translate } from '../../lib/i18n/index';

const badges = [
  { icon: 'leaf', title: translate('home:trust.responsible.title'), text: translate('home:trust.responsible.text') },
  { icon: 'camera', title: translate('home:trust.unique.title'), text: translate('home:trust.unique.text') },
  { icon: 'shield', title: translate('home:trust.safety.title'), text: translate('home:trust.safety.text') },
  { icon: 'users', title: translate('home:trust.personalized.title'), text: translate('home:trust.personalized.text') },
] as const;
---

<section class="bg-surface-warm py-section-gap">
  <div class="mx-auto grid max-w-public grid-cols-1 gap-8 px-page-gutter text-center sm:grid-cols-2 lg:grid-cols-4">
    {badges.map((badge) => (
      <div class="flex flex-col items-center gap-3">
        <span class="text-turquesa" aria-hidden="true">
          {badge.icon === 'leaf' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6" /></svg>
          )}
          {badge.icon === 'camera' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" /><circle cx="12" cy="13" r="3" /></svg>
          )}
          {badge.icon === 'shield' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /></svg>
          )}
          {badge.icon === 'users' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
          )}
        </span>
        <h3 class="font-body text-body1 font-bold text-negro-volcanico">{badge.title}</h3>
        <p class="font-body text-body2 text-azul-condor">{badge.text}</p>
      </div>
    ))}
  </div>
</section>
