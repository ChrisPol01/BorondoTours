---
/** Layout base de Portal Operadores. Tema e idioma compartidos con el B2C (@borondo/ui). */
import '../styles/global.css';

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-surface-page font-body text-text-primary antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-control focus:bg-surface-page focus:px-4 focus:py-2">Saltar al contenido principal</a>
    <slot />
  </body>
</html>